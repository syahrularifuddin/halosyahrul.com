# {$DOMAIN} comes from .env on the VPS via the compose environment.
# Caddy gets and renews the Let's Encrypt cert for it automatically.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Expense tracker (github.com/syahrularifuddin/expense-tracker), its own compose stack
# on this VPS. Reached over the shared `edge` Docker network.
expense.{$DOMAIN} {
	encode zstd gzip
	handle /api/v1/* {
		reverse_proxy expense-api:8080
	}
	handle {
		reverse_proxy expense-web:3000
	}
}

# IG Grabber (github.com/syahrularifuddin/ig-grabber), its own compose stack on
# this VPS. Reached over the shared `edge` Docker network.
ig.{$DOMAIN} {
	encode zstd gzip
	handle /api/* {
		reverse_proxy ig-api:8080
	}
	handle /download {
		reverse_proxy ig-api:8080
	}
	handle {
		reverse_proxy ig-web:3000
	}
}

# Note (github.com/syahrularifuddin/note), its own compose stack on this VPS.
# Reached over the shared `edge` Docker network.
note.{$DOMAIN} {
	encode zstd gzip
	handle /api/* {
		reverse_proxy note-api:8080
	}
	handle {
		reverse_proxy note-web:3000
	}
}
